{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "gogo-thudi.vercel.app"
        }
      ],
      "destination": "https://gogothudi.co.za/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gogo-thudi.vercel.app"
        }
      ],
      "destination": "https://gogothudi.co.za/:path*",
      "permanent": true
    },
    {
      "source": "/services/healing-past-trauma",
      "destination": "/services/emotional-spiritual-guidance",
      "permanent": true
    }
  ]
}
